# Copy to deploy/compose/.env on the VM (never commit .env).

# Image to run: a published release, without the "v".
WATS_VERSION=0.1.0

# Router secret (default /etc/wats/secret.key): owned by uid 65532, mode 0400.
#WATS_ROUTER_KEY=/etc/wats/secret.key

# Disk budget for blobs fetched from other nodes, and largest single blob.
# The VPS has 40 GB of disk; keep room for the OS, images and events.
WATS_BLOB_QUOTA=20G
WATS_MAX_BLOB_SIZE=256M

#RUST_LOG=wats=info,iroh=warn
